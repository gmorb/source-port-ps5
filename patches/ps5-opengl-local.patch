+static void ps5_release_resource_memory_now(void *address, size_t bytes, int64_t direct);
+
+/* zmr: GPU work queued before a resource is destroyed can still read or
+ * write its memory (deferred batches, blits, uploads that hold no reference).
+ * Unmapping it then makes the GPU fault and the system stops the whole app.
+ * Destroyed memory now waits until every GPU batch submitted before the
+ * destroy has finished. ps5_gl_deferred_free = 0 restores immediate release. */
+int ps5_gl_deferred_free = 1;
+unsigned long ps5_gl_deferred_free_peak;
+extern volatile unsigned long ps5_gl_batches_submitted, ps5_gl_batches_retired;
+struct ps5_graveyard_entry { void *address; size_t bytes; int64_t direct; unsigned long mark; };
+static struct ps5_graveyard_entry ps5_graveyard[4096];
+static unsigned ps5_graveyard_count;
+static simple_mtx_t ps5_graveyard_mutex = SIMPLE_MTX_INITIALIZER;
+
+static void
+ps5_graveyard_reap_locked(bool all)
+{
+   const unsigned long retired = ps5_gl_batches_retired;
+   unsigned kept = 0;
+   for (unsigned i = 0; i < ps5_graveyard_count; ++i) {
+      struct ps5_graveyard_entry e = ps5_graveyard[i];
+      if (all || retired >= e.mark)
+         ps5_release_resource_memory_now(e.address, e.bytes, e.direct);
+      else
+         ps5_graveyard[kept++] = e;
+   }
+   ps5_graveyard_count = kept;
+}
+
+void
+ps5_graveyard_reap(void)
+{
+   simple_mtx_lock(&ps5_graveyard_mutex);
+   ps5_graveyard_reap_locked(false);
+   simple_mtx_unlock(&ps5_graveyard_mutex);
+}
+
 static void
 ps5_release_resource_memory(void *address, size_t bytes, int64_t direct)
+{
+   if (!address && direct < 0)
+      return;
+   if (!ps5_gl_deferred_free) {
+      ps5_release_resource_memory_now(address, bytes, direct);
+      return;
+   }
+   simple_mtx_lock(&ps5_graveyard_mutex);
+   ps5_graveyard_reap_locked(false);
+   if (ps5_graveyard_count == ARRAY_SIZE(ps5_graveyard)) {
+      /* Full: give the GPU up to 2 s to retire, then release regardless. */
+      for (unsigned waits = 0; waits < 2000 && ps5_graveyard_count == ARRAY_SIZE(ps5_graveyard); ++waits) {
+         simple_mtx_unlock(&ps5_graveyard_mutex);
+         usleep(1000);
+         simple_mtx_lock(&ps5_graveyard_mutex);
+         ps5_graveyard_reap_locked(false);
+      }
+      if (ps5_graveyard_count == ARRAY_SIZE(ps5_graveyard))
+         ps5_graveyard_reap_locked(true);
+   }
+   ps5_graveyard[ps5_graveyard_count++] = (struct ps5_graveyard_entry){
+      address, bytes, direct, ps5_gl_batches_submitted + 1};
+   if (ps5_graveyard_count > ps5_gl_deferred_free_peak)
+      ps5_gl_deferred_free_peak = ps5_graveyard_count;
+   simple_mtx_unlock(&ps5_graveyard_mutex);
+}
