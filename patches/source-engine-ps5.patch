diff --git a/game/client/c_baseanimating.cpp b/game/client/c_baseanimating.cpp
index d66339e..ff72b6f 100644
--- a/game/client/c_baseanimating.cpp
+++ b/game/client/c_baseanimating.cpp
@@ -3057,11 +3057,83 @@ ConVar r_drawothermodels( "r_drawothermodels", "1", FCVAR_CHEAT, "0=Off, 1=Norma
 // Purpose: Draws the object
 // Input  : flags - 
 //-----------------------------------------------------------------------------
+#ifdef PLATFORM_PS5
+//-----------------------------------------------------------------------------
+// PS5: a character teleported into a scene can be drawn for one frame with
+// its body stretched between the old and new place (or with invalid bone
+// data), and drawing that hangs the PS5's GPU. Skip such frames.
+//-----------------------------------------------------------------------------
+static ConVar ps5_model_guard( "ps5_model_guard", "0", 0, "PS5: skip drawing models on teleport frames or with invalid bones (prevents a GPU hang)" );
+static Vector s_vecPS5LastOrigin[ MAX_EDICTS ];
+static int s_nPS5LastFrame[ MAX_EDICTS ];
+static int s_nPS5SkipFrame[ MAX_EDICTS ];
+
+static bool PS5MatrixOk( const matrix3x4_t &m, const Vector &origin )
+{
+	for ( int r = 0; r < 3; ++r )
+		for ( int c = 0; c < 4; ++c )
+			if ( !IsFinite( m[r][c] ) || fabsf( m[r][c] ) > 65536.0f )
+				return false;
+	Vector pos( m[0][3], m[1][3], m[2][3] );
+	return ( pos - origin ).LengthSqr() < 4096.0f * 4096.0f;
+}
+
+bool C_BaseAnimating::PS5SafeToDraw()
+{
+	if ( !ps5_model_guard.GetBool() )
+		return true;
+	const char *pszWhy = NULL;
+	const Vector &origin = GetRenderOrigin();
+	int idx = entindex();
+	if ( IsNoInterpolationFrame() )
+		pszWhy = "teleport frame";
+	else if ( idx > 0 && idx < MAX_EDICTS && s_nPS5SkipFrame[idx] == gpGlobals->framecount )
+		return false;	// already judged unsafe this frame (other views: shadow, monitor)
+	else if ( idx > 0 && idx < MAX_EDICTS )
+	{
+		if ( s_nPS5LastFrame[idx] >= gpGlobals->framecount - 2 && s_nPS5LastFrame[idx] != gpGlobals->framecount &&
+			 ( origin - s_vecPS5LastOrigin[idx] ).LengthSqr() > 512.0f * 512.0f )
+			pszWhy = "jumped";
+	}
+	if ( idx > 0 && idx < MAX_EDICTS )
+	{
+		s_vecPS5LastOrigin[idx] = origin;
+		s_nPS5LastFrame[idx] = gpGlobals->framecount;
+	}
+	if ( !pszWhy && GetModelPtr() && SetupBones( NULL, -1, BONE_USED_BY_ANYTHING, gpGlobals->curtime ) )
+	{
+		int n = m_CachedBoneData.Count();
+		for ( int i = 0; i < n; ++i )
+			if ( !PS5MatrixOk( m_CachedBoneData[i], origin ) )
+			{
+				pszWhy = "invalid bones";
+				break;
+			}
+	}
+	if ( !pszWhy )
+		return true;
+	if ( idx > 0 && idx < MAX_EDICTS )
+		s_nPS5SkipFrame[idx] = gpGlobals->framecount;
+	static int s_nLogged = 0;
+	if ( s_nLogged < 200 )
+	{
+		++s_nLogged;
+		const model_t *pModel = GetModel();
+		Msg( "[ps5-model] skipped %s (%s) at frame %d\n", pModel ? modelinfo->GetModelName( pModel ) : "?", pszWhy, gpGlobals->framecount );
+	}
+	return false;
+}
+#endif
+
 int C_BaseAnimating::DrawModel( int flags )
 {
 	VPROF_BUDGET( "C_BaseAnimating::DrawModel", VPROF_BUDGETGROUP_MODEL_RENDERING );
 	if ( !m_bReadyToDraw )
 		return 0;
+#ifdef PLATFORM_PS5
+	if ( !PS5SafeToDraw() )
+		return 0;
+#endif
 
 	int drawn = 0;
 
