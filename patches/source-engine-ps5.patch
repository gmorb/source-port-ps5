+		{ KEY_XBUTTON_LEFT, "D-PAD LEFT" }, { KEY_XBUTTON_RIGHT, "D-PAD RIGHT" },
+		{ KEY_XBUTTON_BACK, "TOUCHPAD" }, { KEY_XBUTTON_START, "OPTIONS" },
