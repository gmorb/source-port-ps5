+++ b/game/client/ps5_commandmenu.inc
@@ -0,0 +1,575 @@
+//========= PS5 port: controller-friendly command menu ==========================
+//
+// Opened with Triangle while a menu is up (the PS5 runtime sets a request flag).
+// Categories on the left, their commands on the right with a description of
+// the highlighted one; Cross (or Run) runs it. The command line underneath
+// can be edited with a USB keyboard.
+//
+// The list comes from cfg/ps5_commands.txt (written by the launcher) plus the
+// player's own cfg/ps5_commands_custom.txt, shown as "My commands".
+//
+// A small hint in the menus' corner says which buttons open it.
+//
+// Included at the end of cdll_util.cpp (keeps the build's module lists as
+// they are).
+//===============================================================================
+#ifdef PLATFORM_PS5
+
+#include "tier0/memdbgoff.h"
+#include <vgui/IVGui.h>
+#include <vgui/ISurface.h>
+#include <vgui/IInput.h>
+#include <vgui/IScheme.h>
+#include <vgui_controls/Frame.h>
+#include <vgui_controls/ListPanel.h>
+#include <vgui_controls/Button.h>
+#include <vgui_controls/Label.h>
+#include <vgui_controls/TextEntry.h>
+#include "ienginevgui.h"
+#include "igamesystem.h"
+#include "filesystem.h"
+#include "engine/IEngineSound.h"
+#include "tier0/memdbgon.h"
+extern IEngineSound *enginesound;
+
+extern "C" int zmr_take_command_menu_request( void );	// ps5/runtime/zmr_hid.c
+extern "C" int zmr_osk_open( void );
+extern "C" void zmr_set_skip_shader( const char *list );
+extern "C" void zmr_set_sync_draws( int on );
+extern "C" void zmr_set_skip_material( const char *list );
+CON_COMMAND( ps5_skip_material, "PS5: don't draw materials whose name contains any of these comma-separated fragments" )
+{
+	zmr_set_skip_material( args.ArgC() > 1 ? args.ArgS() : "" );
+}
+CON_COMMAND( ps5_sync_draws, "PS5: 1 = wait for the GPU after every draw (slow; pins down GPU hangs)" )
+{
+	zmr_set_sync_draws( args.ArgC() > 1 ? atoi( args[1] ) : 1 );
+}
+
+// GPU driver (src/platform/ps5_agc_native_runtime.c): cache-flush handling
+// for newly compiled shaders and for batched draws.
+extern "C" int ps5_gl_shader_acquire_mode;
+extern "C" int ps5_gl_keep_batch_acquires;
+extern "C" unsigned long ps5_gl_shader_acquire_count;
+CON_COMMAND( ps5_shader_flush, "PS5: GPU cache flush for new shaders. 0 = off, 1 = first draws (default), 2 = every draw" )
+{
+	if ( args.ArgC() > 1 )
+		ps5_gl_shader_acquire_mode = atoi( args[1] );
+	Msg( "[ps5] shader flush mode %d (%lu flushes so far)\n", ps5_gl_shader_acquire_mode, ps5_gl_shader_acquire_count );
+}
+extern "C" int ps5_gl_cpu_present_blit;
+extern "C" int ps5_gl_cpu_blits;
+CON_COMMAND( ps5_cpu_present, "PS5: 1 = copy each finished frame to the screen with the CPU instead of the GPU (freeze test, slower)" )
+{
+	if ( args.ArgC() > 1 )
+		ps5_gl_cpu_present_blit = atoi( args[1] );
+	Msg( "[ps5] CPU present copy %d\n", ps5_gl_cpu_present_blit );
+}
+extern "C" int ps5_gl_cpu_flip;
+CON_COMMAND( ps5_cpu_flip, "PS5: 1 = wait for the GPU to finish each frame, then show it from the CPU (freeze test)" )
+{
+	if ( args.ArgC() > 1 )
+		ps5_gl_cpu_flip = atoi( args[1] );
+	Msg( "[ps5] CPU flip %d\n", ps5_gl_cpu_flip );
+}
+// ---- Sound freeze repro --------------------------------------------------
+// ps5_sound_stress [play|load] [count]: walks sound/vo and sound/npc and, one
+// file per step, plays (or only loads) sounds the game hasn't used yet. The
+// freeze follows the first use of a sound, so this reproduces it from the
+// menu. Steps run from a "wait" alias loop: ps5_sound_stress_stop ends it.
+extern "C" void zmr_crumb_note( const char *what, unsigned a, unsigned b );
+static void zmr_crumb_note_cpp( const char *pszSound )
+{
+	char note[80];
+	size_t len = strlen( pszSound );
+	Q_snprintf( note, sizeof( note ), "snd stress %s", len > 50 ? pszSound + len - 50 : pszSound );
+	zmr_crumb_note( note, 0, 0 );
+}
+static CUtlVector<CUtlString> s_PS5StressSounds;
+static int s_nPS5StressNext, s_nPS5StressMode;	// mode 0 = play, 1 = load only
+static void PS5CollectSounds( const char *pszDir, int nMax, int nDepth )
+{
+	if ( s_PS5StressSounds.Count() >= nMax || nDepth > 6 )
+		return;
+	char szWild[MAX_PATH];
+	Q_snprintf( szWild, sizeof( szWild ), "%s/*", pszDir );
+	CUtlVector<CUtlString> subdirs;
+	FileFindHandle_t h;
+	for ( const char *pName = g_pFullFileSystem->FindFirstEx( szWild, "GAME", &h ); pName; pName = g_pFullFileSystem->FindNext( h ) )
+	{
+		if ( pName[0] == '.' )
+			continue;
+		char szFull[MAX_PATH];
+		Q_snprintf( szFull, sizeof( szFull ), "%s/%s", pszDir, pName );
+		if ( g_pFullFileSystem->FindIsDirectory( h ) )
+			subdirs.AddToTail( szFull );
+		else if ( Q_stristr( pName, ".wav" ) && s_PS5StressSounds.Count() < nMax )
+			s_PS5StressSounds.AddToTail( szFull + 6 );	// relative to sound/
+	}
+	g_pFullFileSystem->FindClose( h );
+	for ( int i = 0; i < subdirs.Count(); ++i )
+		PS5CollectSounds( subdirs[i].Get(), nMax, nDepth + 1 );
+}
+CON_COMMAND( ps5_sound_stress, "PS5 freeze test: play (or 'load') sounds not used yet, one per step. Args: [play|load] [count]" )
+{
+	s_nPS5StressMode = ( args.ArgC() > 1 && !Q_stricmp( args[1], "load" ) ) ? 1 : 0;
+	int nMax = args.ArgC() > 2 ? atoi( args[2] ) : 300;
+	s_PS5StressSounds.RemoveAll();
+	s_nPS5StressNext = 0;
+	PS5CollectSounds( "sound/vo", nMax / 2, 0 );
+	PS5CollectSounds( "sound/npc", nMax, 0 );
+	PS5CollectSounds( "sound/ambient", nMax, 0 );
+	Msg( "[ps5] sound stress: %d sounds, %s\n", s_PS5StressSounds.Count(), s_nPS5StressMode ? "load only" : "play" );
+	engine->ClientCmd_Unrestricted( "alias ps5_sound_stress_loop \"ps5_sound_stress_step; wait 15; ps5_sound_stress_loop\"; ps5_sound_stress_loop" );
+}
+CON_COMMAND( ps5_sound_stress_step, "PS5: one step of ps5_sound_stress" )
+{
+	if ( s_nPS5StressNext >= s_PS5StressSounds.Count() )
+	{
+		Msg( "[ps5] sound stress finished (%d sounds)\n", s_nPS5StressNext );
+		engine->ClientCmd_Unrestricted( "alias ps5_sound_stress_loop \"\"" );
+		return;
+	}
+	const char *pszName = s_PS5StressSounds[s_nPS5StressNext++].Get();
+	zmr_crumb_note_cpp( pszName );
+	if ( s_nPS5StressMode == 1 )
+	{
+		enginesound->PrecacheSound( pszName, true );
+		Msg( "[ps5] stress %d/%d load %s\n", s_nPS5StressNext, s_PS5StressSounds.Count(), pszName );
+	}
+	else
+	{
+		char cmd[MAX_PATH + 16];
+		Q_snprintf( cmd, sizeof( cmd ), "play \"%s\"\n", pszName );
+		engine->ClientCmd_Unrestricted( cmd );
+		Msg( "[ps5] stress %d/%d play %s\n", s_nPS5StressNext, s_PS5StressSounds.Count(), pszName );
+	}
+}
+CON_COMMAND( ps5_sound_stress_stop, "PS5: stop ps5_sound_stress" )
+{
+	engine->ClientCmd_Unrestricted( "alias ps5_sound_stress_loop \"\"" );
+	s_nPS5StressNext = s_PS5StressSounds.Count();
+}
