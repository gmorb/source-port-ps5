+class CPS5CommandMenu : public vgui::Frame
+{
+	DECLARE_CLASS_SIMPLE( CPS5CommandMenu, vgui::Frame );
+public:
+	CPS5CommandMenu( vgui::VPANEL parent ) : BaseClass( NULL, "PS5CommandMenu" ), m_pData( NULL )
+	{
+		SetParent( parent );
+		SetTitle( "Commands", false );
+		SetSizeable( false );
+		SetMoveable( true );
+		SetDeleteSelfOnClose( false );
+		SetProportional( false );
+
+		m_pCats = new CPS5MenuList( this, "Categories" );
+		m_pCats->AddColumnHeader( 0, "name", "Category", 250, 0 );
+		m_pCats->SetMultiselectEnabled( false );
+		m_pCats->AddActionSignalTarget( this );
+
+		m_pList = new CPS5MenuList( this, "List" );
+		m_pList->AddColumnHeader( 0, "label", "Command", 360, 0 );
+		m_pList->AddColumnHeader( 1, "command", "Runs", 500, 0 );
+		m_pList->SetMultiselectEnabled( false );
+		m_pList->AddActionSignalTarget( this );
+
+		m_pDesc = new vgui::Label( this, "Desc", "" );
+		m_pDesc->SetWrap( true );
+		m_pDesc->SetContentAlignment( vgui::Label::a_northwest );
+
+		m_pEntry = new vgui::TextEntry( this, "Entry" );
+		m_pEntry->SendNewLine( true );
+		m_pEntry->AddActionSignalTarget( this );
+
+		m_pHelp = new vgui::Label( this, "Help",
+			"D-pad: move   Left/Right: categories / commands   Cross: run   Circle or Triangle: close" );
+
+		m_pRun = new vgui::Button( this, "Run", "Run (Cross)", this, "run" );
+		m_pKeyboard = new vgui::Button( this, "Keyboard", "Keyboard...", this, "keyboard" );
+		m_pClose = new vgui::Button( this, "Close", "Close (Circle)", this, "close" );
+
+		SetBounds( 0, 0, 1240, 760 );
+		vgui::ivgui()->AddTickSignal( GetVPanel(), 50 );
+		SetVisible( false );
+	}
+
+	~CPS5CommandMenu()
+	{
+		if ( m_pData )
+			m_pData->deleteThis();
+	}
+
+	void PerformLayout() OVERRIDE
+	{
+		BaseClass::PerformLayout();
+		int w, h;
+		GetSize( w, h );
+		m_pCats->SetBounds( 16, 36, 270, h - 270 );
+		m_pList->SetBounds( 296, 36, w - 312, h - 270 );
+		m_pDesc->SetBounds( 16, h - 226, w - 32, 70 );
+		m_pEntry->SetBounds( 16, h - 148, w - 32, 32 );
+		m_pHelp->SetBounds( 16, h - 108, w - 32, 28 );
+		m_pRun->SetBounds( 16, h - 64, 200, 44 );
+		m_pKeyboard->SetBounds( 232, h - 64, 200, 44 );
+		m_pClose->SetBounds( w - 216, h - 64, 200, 44 );
+	}
+
+	void OnTick() OVERRIDE
+	{
+		BaseClass::OnTick();
+		if ( s_bPS5WeaponMenuHeld )
+			PS5WeaponMenuKeepOpen();
+		if ( zmr_take_command_menu_request() )
+		{
+			if ( IsVisible() )
+				Close();
+			else
+				Open();
+		}
+	}
+
+	void Open()
+	{
+		LoadCommands();
+		int sw, sh;
+		vgui::surface()->GetScreenSize( sw, sh );
+		int w, h;
+		GetSize( w, h );
+		SetPos( ( sw - w ) / 2, ( sh - h ) / 2 );
+		SetVisible( true );
+		MakePopup();
+		MoveToFront();
+		Activate();
+		if ( m_pCats->GetItemCount() > 0 )
+		{
+			m_pCats->SetSingleSelectedItem( m_pCats->GetItemIDFromRow( m_nCategoryRow < m_pCats->GetItemCount() ? m_nCategoryRow : 0 ) );
+			ShowCategory();
+			m_pCats->RequestFocus();
+		}
+	}
+
+	void OnCommand( const char *command ) OVERRIDE
+	{
+		if ( !Q_stricmp( command, "run" ) )
+			RunEntry();
+		else if ( !Q_stricmp( command, "keyboard" ) )
+		{
+			m_pEntry->RequestFocus();
+			m_pEntry->SetText( "" );
+			zmr_osk_open();
+		}
+		else if ( !Q_stricmp( command, "close" ) )
+			Close();
+		else
+			BaseClass::OnCommand( command );
+	}
+
+	void OnKeyCodePressed( vgui::KeyCode code ) OVERRIDE
+	{
+		switch ( GetBaseButtonCode( code ) )
+		{
+		case KEY_XBUTTON_LEFT:
+		case KEY_LEFT:
+			m_pCats->RequestFocus();
+			return;
+		case KEY_XBUTTON_RIGHT:
+		case KEY_RIGHT:
+			if ( m_pList->GetItemCount() > 0 )
+			{
+				if ( m_pList->GetSelectedItemsCount() == 0 )
+					m_pList->SetSingleSelectedItem( m_pList->GetItemIDFromRow( 0 ) );
+				m_pList->RequestFocus();
+			}
+			return;
+		case KEY_XBUTTON_A:
+			RunEntry();
+			return;
+		case KEY_XBUTTON_B:
+		case KEY_ESCAPE:
+			Close();
+			return;
+		default:
+			break;
+		}
+		BaseClass::OnKeyCodePressed( code );
+	}
+
+private:
+	MESSAGE_FUNC_PTR( OnItemSelected, "ItemSelected", panel )
+	{
+		if ( panel == m_pCats )
+		{
+			ShowCategory();
+			return;
+		}
+		int id = m_pList->GetSelectedItem( 0 );
+		KeyValues *kv = id >= 0 ? m_pList->GetItem( id ) : NULL;
+		if ( !kv )
+			return;
+		m_pDesc->SetText( kv->GetString( "description", "" ) );
+		m_pEntry->SetText( kv->GetString( "command", "" ) );
+	}
+
+	MESSAGE_FUNC_PTR( OnTextNewLine, "TextNewLine", panel )
+	{
+		RunEntry();
+	}
+
+	// Cross on a highlighted row (D-pad navigation).
+	MESSAGE_FUNC_PTR( OnItemChosen, "ListPanelItemChosen", panel )
+	{
+		if ( panel == m_pCats )
+		{
+			OnKeyCodePressed( KEY_XBUTTON_RIGHT );
+			return;
+		}
+		RunEntry();
+	}
+
+	void ShowCategory()
+	{
+		m_pList->RemoveAll();
+		m_pDesc->SetText( "" );
+		m_pEntry->SetText( "" );
+		int id = m_pCats->GetSelectedItem( 0 );
+		if ( id < 0 || !m_pData )
+			return;
+		m_nCategoryRow = m_pCats->GetItemCurrentRow( id );
+		KeyValues *cat = m_pData->FindKey( m_pCats->GetItem( id )->GetString( "name" ) );
+		if ( !cat )
+			return;
+		for ( KeyValues *item = cat->GetFirstTrueSubKey(); item; item = item->GetNextTrueSubKey() )
+		{
+			KeyValues *row = new KeyValues( "row" );
+			row->SetString( "label", item->GetString( "label", item->GetName() ) );
+			row->SetString( "command", item->GetString( "command", "" ) );
+			row->SetString( "description", item->GetString( "description", "" ) );
+			m_pList->AddItem( row, 0, false, false );
+			row->deleteThis();
+		}
+	}
+
+	void RunEntry()
+	{
+		char cmd[512];
+		m_pEntry->GetText( cmd, sizeof( cmd ) );
+		if ( !cmd[0] )
+			return;
+		Msg( "[commands] %s\n", cmd );
+		engine->ClientCmd_Unrestricted( cmd );
+		engine->ClientCmd_Unrestricted( "\n" );
+	}
+
+	void AddCategories( KeyValues *file )
+	{
+		for ( KeyValues *cat = file->GetFirstTrueSubKey(); cat; cat = cat->GetNextTrueSubKey() )
+		{
+			// A category holds items (subkeys with a "command"); merge same-named ones.
+			KeyValues *dst = m_pData->FindKey( cat->GetName(), true );
+			for ( KeyValues *item = cat->GetFirstTrueSubKey(); item; item = item->GetNextTrueSubKey() )
+				dst->AddSubKey( item->MakeCopy() );
+		}
+	}
+
+	void LoadCommands()
+	{
+		m_pCats->RemoveAll();
+		m_pList->RemoveAll();
+		if ( m_pData )
+			m_pData->deleteThis();
+		m_pData = new KeyValues( "Commands" );
+
+		KeyValues *file = new KeyValues( "Commands" );
+		if ( file->LoadFromFile( g_pFullFileSystem, "cfg/ps5_commands.txt", "MOD" ) )
+			AddCategories( file );
+		file->deleteThis();
+
+		// The player's own list: either categories, or plain items.
+		file = new KeyValues( "Commands" );
+		if ( file->LoadFromFile( g_pFullFileSystem, "cfg/ps5_commands_custom.txt", "MOD" ) )
+		{
+			KeyValues *first = file->GetFirstTrueSubKey();
+			if ( first && first->FindKey( "command" ) )
+			{
+				KeyValues *dst = m_pData->FindKey( "My commands", true );
+				for ( KeyValues *item = first; item; item = item->GetNextTrueSubKey() )
+					dst->AddSubKey( item->MakeCopy() );
+			}
+			else
+				AddCategories( file );
+		}
+		file->deleteThis();
+
+		for ( KeyValues *cat = m_pData->GetFirstTrueSubKey(); cat; cat = cat->GetNextTrueSubKey() )
+		{
+			KeyValues *row = new KeyValues( "row" );
+			row->SetString( "name", cat->GetName() );
+			m_pCats->AddItem( row, 0, false, false );
+			row->deleteThis();
+		}
+		if ( !m_pData->GetFirstTrueSubKey() )
+			m_pDesc->SetText( "cfg/ps5_commands.txt not found." );
+	}
+
+	KeyValues *m_pData;
+	int m_nCategoryRow = 0;
+	CPS5MenuList *m_pCats, *m_pList;
+	vgui::Label *m_pDesc, *m_pHelp;
+	vgui::TextEntry *m_pEntry;
+	vgui::Button *m_pRun, *m_pKeyboard, *m_pClose;
+};
+
+// Hold L1: show the weapon menu (pictures around the crosshair) for as long
+// as L1 is held, so it's visible before a D-pad direction is pressed.
