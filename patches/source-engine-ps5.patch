+#ifdef PLATFORM_PS5
+//-----------------------------------------------------------------------------
+// PS5: controller-driven mouse for the PC menus. HL2's GameUI dialogs (New
+// Game, Options, Load) are mouse-driven, so while vgui shows the cursor the
+// DualSense acts as a mouse: left stick moves the pointer, Cross clicks,
+// right stick scrolls, Circle sends Escape. These controller events are kept
+// from the game's input while the cursor is up; the D-pad still moves focus.
+//-----------------------------------------------------------------------------
+extern "C" {
+int SDL_SendMouseMotion( SDL_Window *window, Uint32 mouseID, int relative, int x, int y );
+int SDL_SendMouseButton( SDL_Window *window, Uint32 mouseID, Uint8 state, Uint8 button );
+int SDL_SendMouseWheel( SDL_Window *window, Uint32 mouseID, float x, float y, SDL_MouseWheelDirection direction );
+int SDL_SendKeyboardKey( Uint8 state, SDL_Scancode scancode );
+void zmr_hid_poll( SDL_Window *window );
+void zmr_input_controller_used( void );
+int zmr_osk_open( void );
+void zmr_toggle_console( void );
+void zmr_request_command_menu( void );
+}
+
+static ConVar ps5_menu_cursor( "ps5_menu_cursor", "1", FCVAR_ARCHIVE, "PS5: control the menu mouse pointer with the controller" );
+static ConVar ps5_menu_cursor_speed( "ps5_menu_cursor_speed", "1400", FCVAR_ARCHIVE, "PS5: menu pointer speed in pixels per second at full stick" );
+
+static bool s_bPS5MenuCursor = false;
+static int s_nPS5PendingButtons[16];	// queued presses/releases: +1/-1 left click, +2/-2 Escape
+static int s_nPS5Pending = 0;
+static Sint16 s_nPS5Axis[SDL_CONTROLLER_AXIS_MAX];	// last stick values seen in events
+// Last input wins: after the left stick moves the pointer, Cross clicks where
+// the pointer is; after the D-pad moves focus, Cross presses the focused item.
+static bool s_bPS5PointerActive = false;
+static bool s_bPS5CrossToMouse = false;	// route of the Cross press in progress
+
+static int PS5MenuEventFilter( void *, SDL_Event *e )
+{
+	if ( e->type == SDL_CONTROLLERAXISMOTION && e->caxis.axis < SDL_CONTROLLER_AXIS_MAX )
+	{
+		s_nPS5Axis[e->caxis.axis] = e->caxis.value;
+		if ( abs( e->caxis.value ) > 16000 )	// a real push, not stick drift
+			zmr_input_controller_used();
+	}
+	else if ( e->type == SDL_CONTROLLERBUTTONDOWN )
+		zmr_input_controller_used();
+	if ( !s_bPS5MenuCursor )
+		return 1;
+	if ( e->type == SDL_CONTROLLERBUTTONDOWN || e->type == SDL_CONTROLLERBUTTONUP )
+	{
+		const bool bDown = ( e->type == SDL_CONTROLLERBUTTONDOWN );
+		int code = 0;
+		switch ( e->cbutton.button )
+		{
+		case SDL_CONTROLLER_BUTTON_DPAD_UP:
+		case SDL_CONTROLLER_BUTTON_DPAD_DOWN:
+		case SDL_CONTROLLER_BUTTON_DPAD_LEFT:
+		case SDL_CONTROLLER_BUTTON_DPAD_RIGHT:
+			if ( bDown )
+				s_bPS5PointerActive = false;
+			return 1;
+		case SDL_CONTROLLER_BUTTON_A:
+			if ( bDown )
+				s_bPS5CrossToMouse = s_bPS5PointerActive;
+			if ( !s_bPS5CrossToMouse )
+				return 1;	// focus navigation: let vgui see Cross
+			code = 1;
+			break;
+		case SDL_CONTROLLER_BUTTON_B:
+			code = 2;
+			break;
+		case SDL_CONTROLLER_BUTTON_Y:	// Triangle: system on-screen keyboard
+			code = 3;
+			break;
+		case SDL_CONTROLLER_BUTTON_X:	// Square: developer console
+			code = 4;
+			break;
+		default:
+			return 1;
+		}
+		if ( s_nPS5Pending < 16 )
+			s_nPS5PendingButtons[s_nPS5Pending++] = ( e->type == SDL_CONTROLLERBUTTONDOWN ) ? code : -code;
+		if ( code >= 3 && e->type == SDL_CONTROLLERBUTTONDOWN )
+			printf( "[zmr] menu button %s\n", code == 3 ? "Triangle (command menu)" : "Square (console)" );
+		return 0;
+	}
+	if ( e->type == SDL_CONTROLLERAXISMOTION &&
+		 ( e->caxis.axis == SDL_CONTROLLER_AXIS_LEFTX || e->caxis.axis == SDL_CONTROLLER_AXIS_LEFTY ||
+		   e->caxis.axis == SDL_CONTROLLER_AXIS_RIGHTX || e->caxis.axis == SDL_CONTROLLER_AXIS_RIGHTY ) )
+		return 0;
+	return 1;
+}
+
+static float PS5StickCurve( Sint16 raw )
+{
+	const float dz = 0.18f;
+	float v = raw / 32767.0f;
+	float a = fabsf( v );
+	if ( a < dz )
+		return 0.0f;
+	a = ( a - dz ) / ( 1.0f - dz );
+	if ( a > 1.0f ) a = 1.0f;
+	return ( v < 0 ? -1.0f : 1.0f ) * a * a;
+}
+
+static Sint16 PS5Axis( SDL_GameController *pad, SDL_GameControllerAxis a )
+{
+	Sint16 v = s_nPS5Axis[a];
+	if ( pad )
+	{
+		Sint16 p = SDL_GameControllerGetAxis( pad, a );
+		if ( abs( p ) > abs( v ) ) v = p;
+	}
+	return v;
+}
+
+static void PS5UpdateMenuCursor( SDL_Window *pWindow, bool bCursorVisible )
+{
+	static bool s_bInstalled = false;
+	static SDL_GameController *s_pPad = NULL;
+	static Uint64 s_nLast = 0;
+	static float s_flX = -1, s_flY = -1, s_flWheel = 0;
+	static bool s_bClickHeld = false, s_bEscHeld = false;
+
+	if ( !s_bInstalled )
+	{
+		// SDL_SetEventFilter() discards every queued event, which would lose
+		// the window's initial focus event and leave the engine thinking it is
+		// in the background (muted sound, throttled frame rate). Save the
+		// queue and put it back afterwards.
+		static SDL_Event s_saved[256];
+		int n = SDL_PeepEvents( s_saved, 256, SDL_GETEVENT, SDL_FIRSTEVENT, SDL_LASTEVENT );
+		SDL_SetEventFilter( PS5MenuEventFilter, NULL );
+		if ( n > 0 )
+			SDL_PeepEvents( s_saved, n, SDL_ADDEVENT, SDL_FIRSTEVENT, SDL_LASTEVENT );
+		printf( "[zmr] menu pointer filter installed (%d queued events kept)\n", n > 0 ? n : 0 );
+		s_bInstalled = true;
+	}
+	if ( s_pPad && !SDL_GameControllerGetAttached( s_pPad ) )
+	{
+		SDL_GameControllerClose( s_pPad );
+		s_pPad = NULL;
+	}
+	if ( !s_pPad )
+	{
+		for ( int i = 0; i < SDL_NumJoysticks(); ++i )
+			if ( SDL_IsGameController( i ) && ( s_pPad = SDL_GameControllerOpen( i ) ) )
+				break;
+	}
+
+	struct timespec ts;
+	clock_gettime( CLOCK_MONOTONIC, &ts );
+	Uint64 now = (Uint64)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+	float dt = s_nLast ? (float)( ( now - s_nLast ) * 1e-9 ) : 0.0f;
+	s_nLast = now;
+	if ( dt > 0.1f ) dt = 0.1f;
+
+	const bool bWas = s_bPS5MenuCursor;
+	s_bPS5MenuCursor = bCursorVisible && pWindow && ps5_menu_cursor.GetBool();
+	if ( bWas != s_bPS5MenuCursor )
+		printf( "[zmr] menu pointer %s (pad %p, window %p)\n", s_bPS5MenuCursor ? "on" : "off", (void *)s_pPad, (void *)pWindow );
+
+	if ( bWas && !s_bPS5MenuCursor )
+	{
+		// Leaving the menu: let go of anything we hold and hand the game the
+		// sticks' current positions, since their events were filtered.
+		if ( s_bClickHeld && pWindow ) SDL_SendMouseButton( pWindow, 0, SDL_RELEASED, SDL_BUTTON_LEFT );
+		if ( s_bEscHeld ) SDL_SendKeyboardKey( SDL_RELEASED, SDL_SCANCODE_ESCAPE );
+		s_bClickHeld = s_bEscHeld = false;
+		s_nPS5Pending = 0;
+		if ( s_pPad )
+		{
+			SDL_JoystickID id = SDL_JoystickInstanceID( SDL_GameControllerGetJoystick( s_pPad ) );
+			for ( int a = SDL_CONTROLLER_AXIS_LEFTX; a <= SDL_CONTROLLER_AXIS_RIGHTY; ++a )
+			{
+				SDL_Event ev;
+				memset( &ev, 0, sizeof( ev ) );
+				ev.type = SDL_CONTROLLERAXISMOTION;
+				ev.caxis.timestamp = SDL_GetTicks();
+				ev.caxis.which = id;
+				ev.caxis.axis = (Uint8)a;
+				ev.caxis.value = SDL_GameControllerGetAxis( s_pPad, (SDL_GameControllerAxis)a );
+				SDL_PushEvent( &ev );
+			}
+		}
+	}
+	if ( !s_bPS5MenuCursor )
+		return;
+
+	int w = 0, h = 0;
+	SDL_GetWindowSize( pWindow, &w, &h );
+	if ( w <= 0 || h <= 0 ) { w = 1920; h = 1080; }
+	bool bMoved = false;
+	if ( !bWas || s_flX < 0 )
+	{
+		if ( s_flX < 0 ) { s_flX = w * 0.5f; s_flY = h * 0.5f; }
+		bMoved = true;
+	}
+
+	// A USB mouse may have moved the pointer since our last update.
+	static int s_nSentX = -1, s_nSentY = -1;
+	{
+		int qx = 0, qy = 0;
+		SDL_GetMouseState( &qx, &qy );
+		if ( s_nSentX >= 0 && ( qx != s_nSentX || qy != s_nSentY ) )
+		{
+			s_flX = (float)qx; s_flY = (float)qy;
+			s_nSentX = qx; s_nSentY = qy;
+			s_bPS5PointerActive = true;
+		}
+	}
+
+	const float speed = ps5_menu_cursor_speed.GetFloat();
+	float mx = PS5StickCurve( PS5Axis( s_pPad, SDL_CONTROLLER_AXIS_LEFTX ) );
+	float my = PS5StickCurve( PS5Axis( s_pPad, SDL_CONTROLLER_AXIS_LEFTY ) );
+	if ( mx != 0.0f || my != 0.0f )
+	{
+		s_flX = clamp( s_flX + mx * speed * dt, 0.0f, (float)( w - 1 ) );
+		s_flY = clamp( s_flY + my * speed * dt, 0.0f, (float)( h - 1 ) );
+		bMoved = true;
+		s_bPS5PointerActive = true;
+	}
+	if ( bMoved )
+	{
+		SDL_SendMouseMotion( pWindow, 0, 0, (int)s_flX, (int)s_flY );
+		s_nSentX = (int)s_flX; s_nSentY = (int)s_flY;
+	}
+	else if ( s_nSentX < 0 )
+	{
+		s_nSentX = (int)s_flX; s_nSentY = (int)s_flY;
+	}
+	static int s_nDiag = 0;
+	if ( ( mx != 0.0f || my != 0.0f ) && s_nDiag < 5 )
+	{
+		++s_nDiag;
+		int qx = 0, qy = 0;
+		SDL_GetMouseState( &qx, &qy );
+		printf( "[zmr] menu pointer move dt=%.4f stick=%d,%d -> %.0f,%.0f (SDL mouse %d,%d, window %dx%d)\n",
+			dt, s_nPS5Axis[0], s_nPS5Axis[1], s_flX, s_flY, qx, qy, w, h );
+	}
+
+	// Right stick: scroll wheel (about 12 notches per second at full tilt).
+	s_flWheel += -PS5StickCurve( PS5Axis( s_pPad, SDL_CONTROLLER_AXIS_RIGHTY ) ) * 12.0f * dt;
+	while ( s_flWheel >= 1.0f ) { SDL_SendMouseWheel( pWindow, 0, 0, 1, SDL_MOUSEWHEEL_NORMAL ); s_flWheel -= 1.0f; }
+	while ( s_flWheel <= -1.0f ) { SDL_SendMouseWheel( pWindow, 0, 0, -1, SDL_MOUSEWHEEL_NORMAL ); s_flWheel += 1.0f; }
+
+	for ( int i = 0; i < s_nPS5Pending; ++i )
+	{
+		int c = s_nPS5PendingButtons[i];
+		if ( c == 1 && !s_bClickHeld )      { SDL_SendMouseButton( pWindow, 0, SDL_PRESSED, SDL_BUTTON_LEFT ); s_bClickHeld = true; }
+		else if ( c == -1 && s_bClickHeld ) { SDL_SendMouseButton( pWindow, 0, SDL_RELEASED, SDL_BUTTON_LEFT ); s_bClickHeld = false; }
+		else if ( c == 2 && !s_bEscHeld )   { SDL_SendKeyboardKey( SDL_PRESSED, SDL_SCANCODE_ESCAPE ); s_bEscHeld = true; }
+		else if ( c == -2 && s_bEscHeld )   { SDL_SendKeyboardKey( SDL_RELEASED, SDL_SCANCODE_ESCAPE ); s_bEscHeld = false; }
+		else if ( c == 3 )                  { zmr_request_command_menu(); }
+		else if ( c == 4 )                  { zmr_toggle_console(); }
+	}
+	s_nPS5Pending = 0;
+}
+#endif // PLATFORM_PS5
