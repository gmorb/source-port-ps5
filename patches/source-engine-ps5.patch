+// The monitors' camera picture (_rt_Camera) is sampled by the screens before
+// the camera has rendered into it, and the first such read hangs the PS5's
+// GPU. Writing it once per level gives it defined contents first.
+static ConVar ps5_camera_rt_init( "ps5_camera_rt_init", "0", 0, "PS5: clear the monitor camera picture when a level loads (prevents a GPU hang)" );
+static void PS5InitCameraTarget( const char *why )
+{
+	if ( !ps5_camera_rt_init.GetBool() )
+		return;
+	ITexture *pTex = materials->FindTexture( "_rt_Camera", TEXTURE_GROUP_RENDER_TARGET, false );
+	if ( !pTex || pTex->IsError() )
+		return;
+	CMatRenderContextPtr pRenderContext( materials );
+	pRenderContext->PushRenderTargetAndViewport( pTex );
+	pRenderContext->ClearColor4ub( 0, 0, 0, 255 );
+	pRenderContext->ClearBuffers( true, true, false );
+	pRenderContext->PopRenderTargetAndViewport();
+	Msg( "[ps5-monitor] camera picture initialised (%s)\n", why );
+}
+CON_COMMAND( ps5_camera_rt_clear, "PS5: clear the monitor camera picture now" ) { PS5InitCameraTarget( "command" ); }
