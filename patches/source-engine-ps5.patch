+static void PS5WeaponMenuKeepOpen()
+{
+	CBaseHudWeaponSelection *pSel = GetHudWeaponSelection();
+	C_BasePlayer *pPlayer = C_BasePlayer::GetLocalPlayer();
+	if ( !pSel || !pPlayer || !pPlayer->IsAlive() || !pPlayer->GetActiveWeapon() )
